{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client"]
  },
  "include": [
    "src/lastpost",
    "src/app",
    "src/components",
    "src/apps",
    "src/game",
    "src/data",
    "src/main.tsx",
    "vite.config.ts"
  ]
}
